<Window x:Class="SpotLiveV3.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="કૈવલકૃપા સ્ટુડિયો લાઈવ - 4 Camera Live Event Mixer" Width="1500" Height="950" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
<Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="*"/><RowDefinition Height="205"/></Grid.RowDefinitions>
<Border Background="{StaticResource Panel}" CornerRadius="8" Padding="12"><DockPanel><Image Source="KaivalKrupaLogo.png" Width="125" Height="42" Stretch="Uniform" Margin="0,0,12,0"/><TextBlock Text="કૈવલકૃપા સ્ટુડિયો લાઈવ" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/><TextBlock Text="  4-CAMERA REAL-TIME EVENT MIXER" Foreground="#AEB6C4" VerticalAlignment="Center" Margin="15,0,0,0"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="RecBtn" Content="● RECORD" Click="Record_Click" Margin="4" Padding="15,5"/><Button x:Name="StreamBtn" Content="▶ STREAM" Click="Stream_Click" Margin="4" Padding="15,5"/><Button Content="⚙ SETTINGS" Click="Settings_Click" Margin="4" Padding="15,5"/></StackPanel></DockPanel></Border>
<Grid Grid.Row="1" Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="Black" CornerRadius="8" Margin="0,0,10,0"><Grid><Image x:Name="ProgramImage" Stretch="Uniform"/><TextBlock Text="PROGRAM" Foreground="White" FontSize="18" FontWeight="Bold" Margin="15" VerticalAlignment="Top"/></Grid></Border>
<Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8" Margin="0,0,10,0" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="Black" Margin="0,0,4,4"><Grid><Image x:Name="Cam1Image" Stretch="Uniform"/><TextBlock Text="CAM 1" Foreground="White" Margin="8" VerticalAlignment="Top"/></Grid></Border>
<Border Grid.Column="1" Background="Black" Margin="4,0,0,4"><Grid><Image x:Name="Cam2Image" Stretch="Uniform"/><TextBlock Text="CAM 2" Foreground="White" Margin="8" VerticalAlignment="Top"/></Grid></Border>
<Border Grid.Row="1" Background="Black" Margin="0,4,4,0"><Grid><Image x:Name="Cam3Image" Stretch="Uniform"/><TextBlock Text="CAM 3" Foreground="White" Margin="8" VerticalAlignment="Top"/></Grid></Border>
<Border Grid.Row="1" Grid.Column="1" Background="Black" Margin="4,4,0,0"><Grid><Image x:Name="Cam4Image" Stretch="Uniform"/><TextBlock Text="CAM 4" Foreground="White" Margin="8" VerticalAlignment="Top"/></Grid></Border>
</Grid></Border>
<Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="10"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="SOURCES" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/><WrapPanel><Button Content="CAM 1 → A" Click="A1_Click" Margin="3"/><Button Content="CAM 2 → A" Click="A2_Click" Margin="3"/><Button Content="CAM 3 → A" Click="A3_Click" Margin="3"/><Button Content="CAM 4 → A" Click="A4_Click" Margin="3"/><Button Content="CAM 1 → B" Click="B1_Click" Margin="3"/><Button Content="CAM 2 → B" Click="B2_Click" Margin="3"/><Button Content="CAM 3 → B" Click="B3_Click" Margin="3"/><Button Content="CAM 4 → B" Click="B4_Click" Margin="3"/><Button Content="IMAGE" Click="Image_Click" Margin="3"/><Button Content="VIDEO" Click="Video_Click" Margin="3"/></WrapPanel><Separator Margin="0,10"/><TextBlock Text="TRANSITIONS" Foreground="White" FontSize="16"/><WrapPanel><Button Content="CUT" Click="Cut_Click" Margin="3"/><Button Content="FADE" Click="Fade_Click" Margin="3"/><Button Content="WIPE" Click="Wipe_Click" Margin="3"/></WrapPanel><Separator Margin="0,10"/><TextBlock Text="OUTPUT" Foreground="White" FontSize="16"/><TextBlock x:Name="Status" Text="Ready" Foreground="#AEB6C4" TextWrapping="Wrap" Margin="0,5"/></StackPanel></ScrollViewer></Border></Grid>
<Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="SCENES / LIVE GALLERY" Foreground="White" FontSize="18" FontWeight="Bold"/><WrapPanel x:Name="ScenesPanel" Margin="0,8"><Button Content="SCENE 1 • CAM 1" Click="Scene1_Click" Margin="3" Padding="12,8"/><Button Content="SCENE 2 • CAM 2" Click="Scene2_Click" Margin="3" Padding="12,8"/><Button Content="SCENE 3 • CAM 3" Click="Scene3_Click" Margin="3" Padding="12,8"/><Button Content="SCENE 4 • CAM 4" Click="Scene4_Click" Margin="3" Padding="12,8"/><Button Content="SCENE 5 • IMAGE" Click="Scene5_Click" Margin="3" Padding="12,8"/></WrapPanel></StackPanel><StackPanel Grid.Column="1" Margin="15,0"><TextBlock Text="OVERLAY / TITLE" Foreground="White" FontSize="18" FontWeight="Bold"/><TextBox x:Name="OverlayText" Margin="0,8" Height="35" Text=""/><Button Content="APPLY TEXT" Click="ApplyText_Click" Padding="10"/></StackPanel><StackPanel Grid.Column="2" Margin="15,0"><TextBlock Text="AUDIO" Foreground="White" FontSize="18" FontWeight="Bold"/><Slider x:Name="AudioSlider" Minimum="0" Maximum="100" Value="80" Margin="0,12"/><TextBlock Text="MIC / MASTER" Foreground="#AEB6C4"/><Button Content="MUTE / UNMUTE" Click="Mute_Click" Margin="0,8" Padding="10"/></StackPanel></Grid></Border>
</Grid>
</Window>
